flowchart TD
    classDef source fill:#f9f,stroke:#333,stroke-width:2px;
    classDef ingest fill:#bbf,stroke:#333,stroke-width:2px;
    classDef raw fill:#ddd,stroke:#333,stroke-width:2px;
    classDef transform fill:#dfd,stroke:#333,stroke-width:2px;
    classDef validate fill:#fdd,stroke:#333,stroke-width:2px;
    classDef store fill:#ffd,stroke:#333,stroke-width:2px;
    classDef analytic fill:#dff,stroke:#333,stroke-width:2px;
    classDef future fill:#eee,stroke:#333,stroke-width:2px,stroke-dasharray: 5 5;

    %% SOURCE LAYER
    subgraph Source_Layer [1. SOURCE LAYER]
        A1[OpenAQ API v3\nPollution Data] ::: source
        A2[Open-Meteo API v1\nWeather Data] ::: source
    end

    %% INGESTION LAYER
    subgraph Ingestion_Layer [2. INGESTION LAYER - Airflow Orchestrated]
        B1[Python Requests / Pandas\nPollution Collector] ::: ingest
        B2[Python Requests / Pandas\nWeather Collector] ::: ingest
    end

    %% RAW LANDING LAYER
    subgraph Raw_Landing_Layer [3. RAW LANDING LAYER]
        C1[(data/raw/pollution/\nRaw JSON)] ::: raw
        C2[(data/raw/weather/\nRaw JSON)] ::: raw
        C3[Extraction Metadata & Logs] ::: raw
    end

    %% STAGING & TRANSFORMATION LAYER
    subgraph Transformation_Layer [4. STAGING / TRANSFORMATION]
        D1[Timestamp Normalization\n(UTC Flooring)] ::: transform
        D2[Station & Unit\nNormalization] ::: transform
        D3[Pollution & Weather Join\nby City/Station/Time] ::: transform
        D4[Pollutant Aggregation\n(Hourly/Daily)] ::: transform
        D5[AQI Calculation\n(Indian NAQI)] ::: transform
    end

    %% VALIDATION LAYER
    subgraph Validation_Layer [5. VALIDATION]
        E1[Range Checks\n(e.g., negative values)] ::: validate
        E2[Missing-Period Checks] ::: validate
        E3[Duplicate Removal\n(Unique Keys)] ::: validate
        E4[(data/rejected/\nRejected Records CSV)] ::: validate
    end

    %% STORAGE LAYER
    subgraph Storage_Layer [6. STORAGE LAYER - PostgreSQL]
        F1[(aqi_db)] ::: store
        F2[stations table] ::: store
        F3[hourly_air_quality table] ::: store
        F4[daily_aqi table] ::: store
        F5[daily_city_aqi table] ::: store
    end

    %% ANALYTICS & PRESENTATION LAYER
    subgraph Presentation_Layer [7. ANALYTICS / PRESENTATION]
        G1[SQL Analytical Queries] ::: analytic
        G2[Streamlit Dashboard\n- City Analysis\n- Station Analysis\n- AQI Trends\n- Weather Relationships] ::: analytic
    end
    
    %% FUTURE MLOPS EXTENSION
    subgraph Future_Layer [Part 2 - Future MLOps Extension]
        H1[Machine Learning Models\nAQI Prediction] ::: future
        H2[MLflow Tracking] ::: future
        H3[FastAPI Model Serving] ::: future
        H4[Docker Containerization] ::: future
    end

    %% CONNECTIONS
    A1 --> B1
    A2 --> B2
    
    B1 --> C1
    B1 -.-> C3
    B2 --> C2
    B2 -.-> C3
    
    C1 --> D1
    C2 --> D1
    
    D1 --> D2
    D2 --> E1
    E1 -->|Pass| D3
    E1 -->|Fail| E4
    
    D3 --> D4
    D4 --> D5
    
    D5 --> E2
    D5 --> E3
    E3 -->|Pass| F1
    E3 -->|Fail| E4
    
    F1 --- F2
    F1 --- F3
    F1 --- F4
    F1 --- F5
    
    F1 --> G1
    F1 --> G2
    
    G1 -.-> H1
    G2 -.-> H1
