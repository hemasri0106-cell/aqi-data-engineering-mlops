flowchart TD
    classDef source fill:#f9f,stroke:#333,stroke-width:2px;
    classDef ingest fill:#bbf,stroke:#333,stroke-width:2px;
    classDef raw fill:#ddd,stroke:#333,stroke-width:2px;
    classDef transform fill:#dfd,stroke:#333,stroke-width:2px;
    classDef validate fill:#fdd,stroke:#333,stroke-width:2px;
    classDef store fill:#ffd,stroke:#333,stroke-width:2px;
    classDef analytic fill:#dff,stroke:#333,stroke-width:2px;
    classDef future fill:#eee,stroke:#333,stroke-width:2px,stroke-dasharray: 5 5;

    %% SOURCE LAYER
    subgraph Source_Layer [1. SOURCE LAYER]
        A1["OpenAQ API v3<br>Pollution Data"]
        A2["Open-Meteo API v1<br>Weather Data"]
    end

    %% INGESTION LAYER
    subgraph Ingestion_Layer [2. INGESTION LAYER - Airflow Orchestrated]
        B1["Python Requests / Pandas<br>Pollution Collector"]
        B2["Python Requests / Pandas<br>Weather Collector"]
    end

    %% RAW LANDING LAYER
    subgraph Raw_Landing_Layer [3. RAW LANDING LAYER]
        C1[("data/raw/pollution/<br>Raw JSON")]
        C2[("data/raw/weather/<br>Raw JSON")]
        C3["Extraction Metadata & Logs"]
    end

    %% STAGING & TRANSFORMATION LAYER
    subgraph Transformation_Layer [4. STAGING / TRANSFORMATION]
        D1["Timestamp Normalization<br>(UTC Flooring)"]
        D2["Station & Unit<br>Normalization"]
        D3["Pollution & Weather Join<br>by City/Station/Time"]
        D4["Pollutant Aggregation<br>(Hourly/Daily)"]
        D5["AQI Calculation<br>(Indian NAQI)"]
    end

    %% VALIDATION LAYER
    subgraph Validation_Layer [5. VALIDATION]
        E1["Range Checks<br>(e.g., negative values)"]
        E2["Missing-Period Checks"]
        E3["Duplicate Removal<br>(Unique Keys)"]
        E4[("data/rejected/<br>Rejected Records CSV")]
    end

    %% STORAGE LAYER
    subgraph Storage_Layer [6. STORAGE LAYER - PostgreSQL]
        F1[("(aqi_db)")]
        F2["stations table"]
        F3["hourly_air_quality table"]
        F4["daily_aqi table"]
        F5["daily_city_aqi table"]
    end

    %% ANALYTICS & PRESENTATION LAYER
    subgraph Presentation_Layer [7. ANALYTICS / PRESENTATION]
        G1["SQL Analytical Queries"]
        G2["Streamlit Dashboard<br>- City Analysis<br>- Station Analysis<br>- AQI Trends<br>- Weather Relationships"]
    end
    
    %% FUTURE MLOPS EXTENSION
    subgraph Future_Layer [Part 2 - Future MLOps Extension]
        H1["Machine Learning Models<br>AQI Prediction"]
        H2["MLflow Tracking"]
        H3["FastAPI Model Serving"]
        H4["Docker Containerization"]
    end

    %% CONNECTIONS
    A1 --> B1
    A2 --> B2
    
    B1 --> C1
    B1 -.-> C3
    B2 --> C2
    B2 -.-> C3
    
    C1 --> D1
    C2 --> D1
    
    D1 --> D2
    D2 --> E1
    E1 -->|Pass| D3
    E1 -->|Fail| E4
    
    D3 --> D4
    D4 --> D5
    
    D5 --> E2
    D5 --> E3
    E3 -->|Pass| F1
    E3 -->|Fail| E4
    
    F1 --- F2
    F1 --- F3
    F1 --- F4
    F1 --- F5
    
    F1 --> G1
    F1 --> G2
    
    G1 -.-> H1
    G2 -.-> H1

    %% APPLY CLASSES
    class A1,A2 source;
    class B1,B2 ingest;
    class C1,C2,C3 raw;
    class D1,D2,D3,D4,D5 transform;
    class E1,E2,E3,E4 validate;
    class F1,F2,F3,F4,F5 store;
    class G1,G2 analytic;
    class H1,H2,H3,H4 future;
